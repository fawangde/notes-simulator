rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /activationCodes/{codeId} {
      allow read: if request.auth != null;
      allow create, delete: if false;

      // 首次激活：时间码或次数码
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.deviceId == request.auth.uid
        && (
          (
            request.resource.data.mode == 'time'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(['used', 'mode', 'deviceId', 'activatedAt', 'expiresAt', 'codeLength'])
          )
          ||
          (
            request.resource.data.mode == 'clicks'
            && request.resource.data.remainingClicks is int
            && request.resource.data.remainingClicks > 0
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(['used', 'mode', 'deviceId', 'activatedAt', 'remainingClicks', 'codeLength'])
          )
        );

      // 次数码：已激活设备扣减 remainingClicks
      allow update: if request.auth != null
        && resource.data.used == true
        && resource.data.deviceId == request.auth.uid
        && resource.data.mode == 'clicks'
        && request.resource.data.remainingClicks is int
        && request.resource.data.remainingClicks == resource.data.remainingClicks - 1
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['remainingClicks']);
    }
  }
}
